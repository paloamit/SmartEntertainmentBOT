# ---------------------------------------------------------------------------
# Smart Entertainment BOT — backend configuration.
# Copy this file to ".env" and fill in your keys.
# ---------------------------------------------------------------------------

# =========================== LLM (Groq, free tier) =========================
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1

# Large model  -> recommendations, comparisons, plot summaries, criticism.
LLM_MODEL_LARGE=llama-3.3-70b-versatile
# Small model  -> greeting, session titles, scope checks, cast lists, names.
LLM_MODEL_SMALL=llama-3.1-8b-instant

# Failover chain -> comma-separated models tried in order when the routed one
# is rate-limited or overloaded. Free tiers meter quota PER MODEL, so a second
# model usually still has budget when the first is exhausted. Every entry must
# support tool calling, since the whole app is built on the tools.
LLM_FAILOVER_ENABLED=true
LLM_FAILOVER_MODELS=qwen/qwen3.8-27b,llama-3.3-70b-versatile

# Vision model -> recognises a movie / series / anime poster from an uploaded
# image. Groq hosts these on the FREE tier:
#   meta-llama/llama-4-scout-17b-16e-instruct   (default, supports images)
#   meta-llama/llama-prompt-image-4096          (older fallback)
# Set LLM_VISION_API_KEY / LLM_VISION_BASE_URL to use a different provider
# (e.g. Gemini's OpenAI-compatible endpoint) for images only.
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=

# Poster uploads (images only)
MAX_UPLOAD_MB=8

# ======================== Entertainment data sources =======================
# TMDB — the primary source of truth for every title. Free key:
# https://www.themoviedb.org/settings/api  (Approval is usually instant.)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Optional — OMDb supplies the real IMDb rating (10 requests/sec, 1k/day free):
# http://www.omdbapi.com/apikey.aspx
# Leave blank and the bot falls back to the TMDB score.
OMDB_API_KEY=

# Watchmode — the only reachable provider that does BOTH live-action discovery
# (genre / year / country) AND "where to watch". Free plan: web links work,
# deep links do not, and only some regions are enabled (detected at runtime).
# https://www.watchmode.com/requestApiKey
WATCHMODE_API_KEY=

# No-key fallbacks, used when TMDB is unavailable. AniList is the most capable
# of these: it supports real discovery (genre + year + country + sort).
ENABLE_ANILIST_FALLBACK=true  # anime   — https://anilist.co (GraphQL, no key)
ENABLE_JIKAN_FALLBACK=true    # anime   — https://jikan.moe
ENABLE_TVMAZE_FALLBACK=true   # series — https://tvmaze.com

# =============================== Cache (24h) ==============================
# Optional. Leave blank to use the built-in in-process cache (same 24h TTL,
# fine for a single instance). Set a URL to share the cache across instances.
#   Render Redis : redis://:<password>@<host>:6379/0
#   Upstash      : rediss://default:<password>@<host>:6379
# https://console.upstash.com
REDIS_URL=
CACHE_TTL_SECONDS=86400
CACHE_PREFIX=sebot

# =================================== App ===================================
DB_PATH=entertainment.db
# Postgres (Render / Neon) — set this to survive free-tier restarts:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=

# Hard cap on sidebar sessions. Creating a new chat fails until one is deleted.
MAX_SESSIONS=5
# Hard cap on user questions per session (assistant replies don't count).
MAX_QUERIES_PER_SESSION=10
# Never show more than this many titles in one recommendation.
MAX_RECOMMENDATIONS=5
# Past turns replayed to the LLM (token control).
MAX_HISTORY_MESSAGES=14
CORS_ORIGINS=*

# ================================ Identity ================================
# Sessions are scoped to a browser-generated visitor id, so a returning user
# finds their chats exactly as they left them.
# ENABLE_IDENTITY_UNLOCK lets a user set a passphrase ("sync code") to restore
# the same sessions on another device. Turn off to disable.
ENABLE_IDENTITY_UNLOCK=true

# ============================== Observability ==============================
# Langfuse LLM tracing — https://cloud.langfuse.com -> Settings -> API Keys.
# Leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Prometheus metrics at GET /metrics
ENABLE_METRICS=true

# ================================== Costs ==================================
# USD per 1M tokens — used for the /api/observability/usage cost report.
# Groq public rates; override if they change.
PRICE_PROMPT_SMALL=0.05
PRICE_COMPLETION_SMALL=0.08
PRICE_PROMPT_LARGE=0.59
PRICE_COMPLETION_LARGE=0.79

# ---- dev helper (live reload) ----
nodemon --watch app --ext py,pyc --exec "uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload-dir app"
